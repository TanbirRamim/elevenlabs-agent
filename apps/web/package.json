    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "jsdom": "^30.1.1",
    "tailwindcss": "^4.3.3",
    "wrangler": "^4.147.0"
  },
  "dependencies": {
    "@elevenlabs/react": "^1.16.0",
    "@opennextjs/cloudflare": "^1.20.8",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@shadow/guard": "workspace:*",
    "@shadow/schema": "workspace:*",
    "@splinetool/react-spline": "^4.1.0",
