# Copy to .env and fill in. Every variable here is validated at startup
# (apps/api/src/env.ts, apps/web/src/env.ts). Never commit .env.

# --- ElevenLabs (server-side only; never exposed to the browser) ---
ELEVENLABS_API_KEY=
ELEVENLABS_INTERVIEWER_AGENT_ID=
ELEVENLABS_TUTOR_AGENT_ID=

# --- Anthropic ---
ANTHROPIC_API_KEY=
# Model used by every LLM route; per-route effort lives in packages/prompts.
SHADOW_MODEL=claude-opus-5-5

# --- API service ---
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
# Allowed browser origins, comma-separated (add the deployed web URL)
WEB_ORIGIN=http://localhost:3000
DATABASE_URL=postgres://shadow:shadow@localhost:5432/shadow
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=shadow-frames
S3_ACCESS_KEY=shadow
S3_SECRET_KEY=shadowsecret
PRESIDIO_ANALYZER_URL=http://localhost:5002
PRESIDIO_ANONYMIZER_URL=http://localhost:5001
PRESIDIO_IMAGE_REDACTOR_URL=http://localhost:5003
LOG_LEVEL=info
# 1 = serve fixture data instead of calling Claude/Presidio (UI work without the pipeline)
MOCK_AI=0
# Capture screen signal: vision = frames only, works on any app (DeskSim DOM events only score
# vision/DOM agreement); vision+desk = DOM events also drive questions and the Work Map
CAPTURE_SIGNALS=vision
# server: Presidio OCR-redacts every frame (default). browser: trust the in-browser blackout of
# marked personal-data fields (for small hosts where OCR would time out and drop every frame).
FRAME_REDACTION=server
# ms the guard waits for the LLM judge before a save is let through as timeout_allow (6 s, see #74)
GUARD_JUDGE_TIMEOUT_MS=6000
# Dir with workmap.json (+ recordings/<sessionId>.webm) published at boot when nothing is.
# Unset: seed/boot (the demo map). Set to an empty value to turn boot restore off.
# SHADOW_BOOT_DIR=
# 1 = use seed/reference-guardrails.json when no Work Map is published. Never in a judged run.
DEMO_FALLBACK_RULES=0

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_API_WS_URL=ws://localhost:4000
# Optional: public Spline scene URL (https) for the landing hero; the 3D orb is used when empty
NEXT_PUBLIC_SPLINE_SCENE_URL=
